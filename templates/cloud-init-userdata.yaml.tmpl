#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
ssh_pwauth: true
users:
  - default
  - name: ${admin_username}
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    ssh_authorized_keys:
%{ for k in ssh_keys ~}
      - ${k}
%{ endfor ~}

chpasswd:
  list: |
    ${admin_username}:${admin_password}
  expire: false

${disk_block}
